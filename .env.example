# ============================================================
# CLOUDTIFY — Environment Variables Reference
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── SUPABASE ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # Never expose on client

# ─── CLOUDFLARE R2 ───────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_BUCKET_NAME=cloudtify-files
R2_BUCKET_THUMBNAIL=cloudtify-thumbnails
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://files.cloudtify.com        # Custom domain or R2.dev URL
R2_THUMBNAIL_URL=https://thumb.cloudtify.com

# ─── MIDTRANS (Indonesia Payment) ────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx          # Use SB- prefix for sandbox
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_ENVIRONMENT=sandbox                     # sandbox | production
MIDTRANS_WEBHOOK_SECRET=your_webhook_secret

# ─── FIREBASE (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=cloudtify-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@cloudtify-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── POSTHOG (Analytics) ─────────────────────────────────────
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# ─── APP URLS ────────────────────────────────────────────────
APP_URL=https://cloudtify.com
API_URL=https://api.cloudtify.com
ADMIN_URL=https://admin.cloudtify.com

# ─── MOBILE APP (Expo) ───────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_R2_PUBLIC_URL=https://files.cloudtify.com
EXPO_PUBLIC_R2_THUMBNAIL_URL=https://thumb.cloudtify.com
EXPO_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
EXPO_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_APP_URL=https://cloudtify.com

# ─── ADMIN PANEL ─────────────────────────────────────────────
ADMIN_SECRET=super_secret_admin_jwt_secret_32chars_min

# ─── RATE LIMITING ───────────────────────────────────────────
UPSTASH_REDIS_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# ─── EMAIL ───────────────────────────────────────────────────
# Supabase handles transactional email via SMTP settings
# Configure in Supabase Dashboard > Project Settings > Auth > SMTP Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
SMTP_FROM=noreply@cloudtify.com
